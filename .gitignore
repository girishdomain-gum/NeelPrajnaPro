# QRF .gitignore — fresh-start era (S01)

# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
build/
dist/

# --- Tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- MT5 compiled artifacts (source .mq5 is tracked; binaries are not) ---
*.ex5
*.ex4

# --- Firewall drill tamper files (tests/test_firewall.py plants these under
# qrf/ and runtime/ to prove the wall can fail; try/finally removes them, but
# this rule is the last line of defence if a run is killed mid-drill) ---
_drill_tamper_tmp.py

# NOTE: uv.lock is intentionally NOT ignored — it must be committed.

comms/
