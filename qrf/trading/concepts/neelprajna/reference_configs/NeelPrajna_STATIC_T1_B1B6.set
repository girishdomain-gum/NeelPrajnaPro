; NeelPrajna_STATIC_T1_B1B6.set
; ============================================================
; TODAY'S form for contrast: a STATIC strategy as a .set file —
; the whole strategy is which gate enables are true. This is
; exactly your existing T1_B1B6 preset shape.
;
; After Phase 6c this same file keeps working UNCHANGED: with
; InpSeq_Kind empty (or STATIC), the engine reads the per-gate
; enables the legacy way, which internally compiles to the
; one-step sequence
;   STEP1 = GUARD:B1+B6 ADV:T1 WIN:0 INV:NONE
; — the formal superset relationship (design doc §2.3), proven
; deal-for-deal by the 6c A/B gate before the old path retires.
; STATUS: the gate-enable half is today's real format; the
; InpSeq_ lines are the Phase-6a additions (default-empty, so
; old .set files remain valid without editing).
; ============================================================

; ==== EA Settings ====
InpDebugMode=false||false||0||true||N
InpLogToFile=true||false||0||true||N
InpMagicBase=26071100||26071100||1||26071100||N

; ==== Risk / Reward ====
InpMaxRiskPct=1.5||1.5||0.1||1.5||N
InpEnableTP=true||false||0||true||N
InpRRRatio=2.0||2.0||0.5||4.0||N

; ---- the strategy IS these thirteen booleans ----
InpB1_Enabled=true||false||0||true||N
InpB2_Enabled=false||false||0||true||N
InpB3_Enabled=false||false||0||true||N
InpB4_Enabled=false||false||0||true||N
InpB6_Enabled=true||false||0||true||N
InpT1_Enabled=true||false||0||true||N
InpT2_Enabled=false||false||0||true||N
InpT3_Enabled=false||false||0||true||N
InpT4_Enabled=false||false||0||true||N
InpT5_Enabled=false||false||0||true||N
InpT7_Enabled=false||false||0||true||N
InpT8_Enabled=false||false||0||true||N
InpT9_Enabled=false||false||0||true||N

; ==== Sequential Strategy (Phase 6, NEW — inert here) ====
InpSeq_Kind=
InpSeq_Name=
InpSeq_Step1=
InpSeq_Step2=
InpSeq_Step3=
InpSeq_Step4=
